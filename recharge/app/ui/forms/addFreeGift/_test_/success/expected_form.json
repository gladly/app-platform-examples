{
  "title": "Add free gift",
  "submitButton": "Add gift",
  "closeButton": "Close",
  "sections": [
    {
      "type": "input",
      "label": "Charge",
      "attr": "chargeId",
      "input": {
        "type": "select",
        "placeholder": "Select the order to add the gift to.",
        "options": [
          {
            "text": "Next order — ships 2026-08-20 (#1839251121)",
            "value": "1839251121"
          },
          {
            "text": "Retrying order — was 2026-09-01 (#1839251199)",
            "value": "1839251199"
          }
        ],
        "optional": false
      }
    },
    {
      "type": "input",
      "label": "Shopify variant ID",
      "attr": "externalVariantId",
      "input": {
        "type": "text",
        "placeholder": "e.g. 51139736109343",
        "optional": false
      },
      "hint": "The Shopify variant ID of the product to add as a free gift."
    },
    {
      "type": "input",
      "label": "Quantity",
      "attr": "quantity",
      "input": {
        "type": "text",
        "placeholder": "1",
        "optional": false
      }
    }
  ]
}
